{
  "name": "@aeki/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && concurrently -k \"tsc -p tsconfig.json --watch\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build -w @aeki/contracts"
  },
  "dependencies": {
    "@aeki/contracts": "0.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2"
  },
  "type": "module"
}
